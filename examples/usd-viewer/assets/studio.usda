#usda 1.0
(
    defaultPrim = "Studio"
    upAxis = "Y"
    metersPerUnit = 1
)

def Xform "Studio"
{
    def Scope "Materials"
    {
        def Material "Coral"
        {
            token outputs:surface.connect = </Studio/Materials/Coral/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.65, 0.12, 0.07)
                float inputs:metallic = 0.12
                float inputs:roughness = 0.32
                token outputs:surface
            }
        }

        def Material "Jade"
        {
            token outputs:surface.connect = </Studio/Materials/Jade/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.05, 0.42, 0.32)
                float inputs:metallic = 0.65
                float inputs:roughness = 0.22
