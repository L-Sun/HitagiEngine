{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "$id": "https://hitagi.example/schema/material.json",
  "title": "Hitagi material",
  "type": "object",
  "required": [
    "name",
    "passes"
  ],
  "properties": {
    "name": {
      "type": "string",
      "title": "Material name",
      "examples": [
        "DemoMaterial"
      ]
    },
    "source_shader_id": {
      "type": "string",
      "title": "Authoring source shader id"
    },
    "parameters": {
      "type": "array",
      "title": "Named material parameter values",
      "items": {
        "type": "object",
        "required": [
          "name",
          "type"
        ],
        "properties": {
          "name": {
            "type": "string",
            "examples": [
              "base_color",
              "roughness",
              "base_color_texture"
            ]
          },
          "type": {
            "type": "string",
            "enum": [
              "float",
              "int32",
              "uint32",
              "vec2i",
              "vec2u",
              "vec2f",
              "vec3i",
              "vec3u",
              "vec3f",
              "vec4i",
              "vec4u",
              "vec4f",
              "color",
              "mat4f",
              "texture"
            ]
          },
          "default": {
            "type": [
              "array",
              "number",
              "integer",
              "string",
              "null"
            ]
          }
        }
      }
    },
    "passes": {
      "type": "array",
      "title": "Pass-local render contracts",
      "items": {
        "type": "object",
        "required": [
          "contract",
          "bindings"
        ],
        "properties": {
          "contract": {
            "type": "string",
            "examples": [
              "GBuffer",
              "ShadowCaster",
              "Forward"
            ]
          },
          "pipeline": {
            "type": "object",
            "required": [
              "vs",
              "ps"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "vs": {
                "type": "string",
                "examples": [
                  "assets/shaders/deferred_gbuffer.hlsl"
                ]
              },
              "ps": {
                "type": "string",
                "examples": [
                  "assets/shaders/deferred_gbuffer.hlsl"
                ]
              },
              "primitive": {
                "type": "string",
                "default": "TriangleList",
                "enum": [
                  "PointList",
                  "LineList",
                  "LineStrip",
                  "TriangleList",
                  "TriangleStrip",
                  "LineListAdjacency",
                  "LineStripAdjacency",
                  "TriangleListAdjacency",
                  "TriangleStripAdjacency"
                ]
              },
              "depth_test": {
                "type": "boolean",
                "default": true
              },
              "double_sided": {
                "type": "boolean",
                "default": false
              }
            }
          },
          "bindings": {
            "type": "array",
            "title": "Ordered material parameter bindings",
            "items": {
              "type": "string"
            },
            "examples": [
              [
                "base_color",
                "roughness",
                "base_color_texture"
              ]
            ]
          }
        }
      }
    }
  },
  "examples": [
    {
      "name": "DemoMaterial",
      "parameters": [
        {
          "name": "base_color",
          "type": "color",
          "default": [
            1.0,
            0.8,
            0.5,
            1.0
          ]
        },
        {
          "name": "roughness",
          "type": "float",
          "default": 0.5
        },
        {
          "name": "base_color_texture",
          "type": "texture",
          "default": "assets/test/test.jpg"
        }
      ],
      "passes": [
        {
          "contract": "GBuffer",
          "pipeline": {
            "vs": "assets/shaders/deferred_gbuffer.hlsl",
            "ps": "assets/shaders/deferred_gbuffer.hlsl",
            "primitive": "TriangleList"
          },
          "bindings": [
            "base_color",
            "roughness",
            "base_color_texture"
          ]
        }
      ]
    }
  ]
}
