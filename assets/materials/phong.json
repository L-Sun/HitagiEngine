{
    "$schema": "../utils/material_schema.json",
    "name": "Phong",
    "pipeline": {
        "vs": "assets/shaders/phong.hlsl",
        "ps": "assets/shaders/phong.hlsl",
        "primitive": "TriangleList",
        "depth_test": true
    },
    "parameters": [
        {
            "name": "shininess",
            "type": "float",
            "default": 1.0
        },
        {
            "name": "roughness",
            "type": "float",
            "default": 0.5
        },
        {
            "name": "metallic",
            "type": "float",
            "default": 0.0
        },
        {
            "name": "occlusion",
            "type": "float",
            "default": 1.0
        },
        {
            "name": "diffuse",
            "type": "color",
            "default": [
                1.0,
                1.0,
                1.0,
                1.0
            ]
        },
        {
            "name": "specular",
            "type": "color",
            "default": [
                1.0,
                1.0,
                1.0,
                1.0
            ]
        },
        {
            "name": "ambient",
            "type": "color",
            "default": [
                0.08,
                0.08,
                0.08,
                1.0
            ]
        },
        {
            "name": "emissive",
            "type": "color",
            "default": [
                0.0,
                0.0,
                0.0,
                1.0
            ]
        },
        {
            "name": "diffuse_texture",
            "type": "texture"
        },
        {
            "name": "specular_texture",
            "type": "texture"
        },
        {
            "name": "ambient_texture",
            "type": "texture"
        },
        {
            "name": "emissive_texture",
            "type": "texture"
        },
        {
            "name": "metallic_roughness_texture",
            "type": "texture"
        },
        {
            "name": "normal_texture",
            "type": "texture"
        },
        {
            "name": "occlusion_texture",
            "type": "texture"
        }
    ]
}
